// Refleqt v2.0 - Prisma Schema
// Complete database schema for all features

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ============================================================================
// Users & Authentication
// ============================================================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String? // Optional: for email/password auth
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  profile             UserProfile?
  competitors         Competitor[]
  intelligenceSources IntelligenceSource[]
  intelligenceItems   IntelligenceItem[]
  researchGoals       ResearchGoal[]
  smartTrackers       SmartTracker[]
  researchSwarms      ResearchSwarm[]
  synthesizedInsights SynthesizedInsight[]
  knowledgeNodes      KnowledgeNode[]
  strategyCohorts     StrategyCohort[]
  psychographicSegs   PsychographicSegment[]
  breweryOutputs      BreweryOutput[]
  breweryItems        BreweryItem[]
  writerRequests      WriterRequest[]
  obsessionScores     ObsessionScore[]
  swarmTemplates      SwarmTemplate[]
  swarmSettings       SwarmSettings?
  swarmAnalytics      SwarmAnalytics[]
  accounts            Account[]
  sessions            Session[]

  @@map("users")
}

model UserProfile {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  companyName       String   @map("company_name")
  industry          String
  businessChallenge String?  @map("business_challenge")
  obsessionScore    Float  @default(0.0) @map("obsession_score")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// NextAuth.js tables
model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// Competitors
// ============================================================================

model Competitor {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  name          String
  website       String?
  socialHandles Json?    @map("social_handles") // {twitter: "@handle", linkedin: "company"}
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("competitors")
}

// ============================================================================
// Intelligence Feed
// ============================================================================

model IntelligenceSource {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  sourceType    String    @map("source_type") // 'rss', 'twitter', 'linkedin', 'youtube', 'website'
  sourceUrl     String    @map("source_url")
  sourceName    String?   @map("source_name")
  category      String? // 'news', 'competitor', 'industry', 'geopolitical'
  isActive      Boolean   @default(true) @map("is_active")
  lastFetchedAt DateTime? @map("last_fetched_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  // Relations
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  intelligenceItems IntelligenceItem[]

  @@unique([userId, sourceUrl])
  @@map("intelligence_sources")
}

model IntelligenceItem {
  id             String                       @id @default(uuid())
  sourceId       String                       @map("source_id")
  userId         String                       @map("user_id")
  title          String                      
  content        String                      
  url            String?                     
  author         String?
  publishedAt    DateTime?                    @map("published_at")
  fetchedAt      DateTime                     @default(now()) @map("fetched_at")
  relevanceScore Float?                     @map("relevance_score")
  // embedding      Unsupported("vector(1536)") // TODO: Re-enable after pgvector setup
  metadata       Json? // flexible storage for source-specific data
  createdAt      DateTime                     @default(now()) @map("created_at")

  // Relations
  source IntelligenceSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, publishedAt(sort: Desc)])
  @@map("intelligence_items")
}

// ============================================================================
// Research Swarms - MCP Architecture
// ============================================================================

// Research Goals (replaces simple RSS sources)
model ResearchGoal {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  goalTitle       String    @map("goal_title")
  goalQuery       String    @map("goal_query")
  goalType        String    @map("goal_type") // 'competitive', 'market', 'customer', 'industry'
  mcpChainConfig  Json?     @map("mcp_chain_config") // MCP chain configuration
  isActive        Boolean   @default(true) @map("is_active")
  monitoringLevel String    @default("daily") @map("monitoring_level") // 'realtime', 'hourly', 'daily'
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  swarms     ResearchSwarm[]
  trackers   SmartTracker[]

  @@map("research_goals")
}

// Smart Trackers for continuous monitoring
model SmartTracker {
  id               String    @id @default(uuid())
  goalId           String    @map("goal_id")
  userId           String    @map("user_id")
  updateInterval   Int       @map("update_interval") // seconds between checks
  maxInsights      Int       @default(10) @map("max_insights") // finite introspect bound
  lastExecutedAt   DateTime? @map("last_executed_at")
  nextExecutionAt  DateTime? @map("next_execution_at")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")

  // Relations
  goal      ResearchGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive, nextExecutionAt])
  @@map("smart_trackers")
}

// MCP Swarm Executions
model ResearchSwarm {
  id               String    @id @default(uuid())
  goalId           String?   @map("goal_id") // nullable for ad-hoc queries
  userId           String    @map("user_id")
  query            String   
  swarmType        String    @map("swarm_type") // 'competitive', 'market', 'customer', 'product'
  swarmSize        String    @default("small") @map("swarm_size") // 'small' (3 agents), 'large' (8 agents)
  status           String    @default("pending") // 'pending', 'running', 'processing', 'completed', 'failed'
  progressPct      Int       @default(0) @map("progress_percent")
  timeRemaining    String?   @map("time_remaining") // e.g., "2 min", "5 min"
  mcpChainUsed     Json?     @map("mcp_chain_used") // actual MCP chain executed
  agentResults     Json?     @map("agent_results") // raw agent outputs
  synthesisApplied Boolean   @default(false) @map("synthesis_applied")
  executionTimeMs  Int?      @map("execution_time_ms")
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  // Relations
  goal            ResearchGoal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  findings        SwarmFinding[]
  synthesizedData SynthesizedInsight[]
  recommendations SwarmRecommendation[]

  @@index([userId, status])
  @@index([createdAt(sort: Desc)])
  @@map("research_swarms")
}

// Raw findings (before synthesis)
model SwarmFinding {
  id              String   @id @default(uuid())
  swarmId         String   @map("swarm_id")
  agentId         String?  @map("agent_id") // which agent found this
  findingType     String?  @map("finding_type") // 'insight', 'trend', 'opportunity', 'threat'
  title           String? 
  content         String  
  confidenceScore Float? @map("confidence_score")
  sources         Json? // array of source references
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  swarm ResearchSwarm @relation(fields: [swarmId], references: [id], onDelete: Cascade)

  @@map("swarm_findings")
}

// Strategic Recommendations from Swarms
model SwarmRecommendation {
  id            String   @id @default(uuid())
  swarmId       String   @map("swarm_id")
  action        String  
  impact        String  
  priority      String // 'HIGH', 'MEDIUM', 'LOW'
  timeline      String
  effort        String
  revenueImpact String?  @map("revenue_impact")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  swarm ResearchSwarm @relation(fields: [swarmId], references: [id], onDelete: Cascade)

  @@index([swarmId, priority])
  @@map("swarm_recommendations")
}

// Pre-built Swarm Templates
model SwarmTemplate {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id") // null = system template
  title       String
  description String  
  icon        String
  query       String  
  swarmType   String   @map("swarm_type") // 'competitive', 'market', 'customer', 'product'
  isPublic    Boolean  @default(false) @map("is_public")
  usageCount  Int      @default(0) @map("usage_count")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isPublic])
  @@index([swarmType])
  @@map("swarm_templates")
}

// User Swarm Configuration
model SwarmSettings {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  researchDepth    String   @default("STANDARD") @map("research_depth") // 'STANDARD', 'DEEP', 'COMPREHENSIVE'
  analysisSpeed    String   @default("BALANCED") @map("analysis_speed") // 'FAST', 'BALANCED', 'THOROUGH'
  resultFormat     String   @default("EXECUTIVE") @map("result_format") // 'EXECUTIVE', 'DETAILED', 'ACTION_ORIENTED'
  dataSources      String @map("data_sources") // Array of enabled sources
  notifications    Json // Notification preferences
  focusAreas       String @map("focus_areas") // Industry focus areas
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("swarm_settings")
}

// Analytics for Swarm Performance
model SwarmAnalytics {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  date            DateTime
  totalSwarms     Int      @map("total_swarms")
  completedSwarms Int      @map("completed_swarms")
  failedSwarms    Int      @map("failed_swarms")
  avgDuration     Int      @map("avg_duration") // milliseconds
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@map("swarm_analytics")
}

// Synthesized Insights (finite introspect output - max 10)
model SynthesizedInsight {
  id                String                       @id @default(uuid())
  swarmId           String                       @map("swarm_id")
  userId            String                       @map("user_id")
  title             String                      
  content           String                      
  hierarchyLevel    String                       @map("hierarchy_level") // 'strategic', 'tactical', 'operational'
  priorityScore     Float                      @map("priority_score") // 0.0-1.0
  relevanceScore    Float                      @map("relevance_score") // 0.0-1.0
  isActionable      Boolean                      @default(false) @map("is_actionable")
  actionItems       String // max 5 action items
  sourceFindingIds  String                     @map("source_finding_ids") // references to SwarmFindings
  // embedding      Unsupported("vector(1536)") // TODO: Re-enable after pgvector setup
  psychographicTags String                     @map("psychographic_tags")
  displayPosition   Int?                         @map("display_position") // 1-10 for finite introspect
  dismissedAt       DateTime?                    @map("dismissed_at")
  createdAt         DateTime                     @default(now()) @map("created_at")

  // Relations
  swarm ResearchSwarm @relation(fields: [swarmId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, hierarchyLevel, priorityScore(sort: Desc)])
  @@index([userId, dismissedAt])
  @@map("synthesized_insights")
}

// Knowledge Traverse Hierarchy Nodes
model KnowledgeNode {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  parentId       String?  @map("parent_id") // for tree structure
  nodeTitle      String   @map("node_title")
  nodeContent    String?  @map("node_content")
  hierarchyLevel String   @map("hierarchy_level") // 'strategic', 'tactical', 'operational'
  depth          Int      @default(0) // tree depth (0 = root)
  insightIds     String @map("insight_ids") // linked insights
  relevanceScore Float  @map("relevance_score")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   KnowledgeNode?  @relation("KnowledgeHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children KnowledgeNode[] @relation("KnowledgeHierarchy")

  @@index([userId, hierarchyLevel])
  @@index([parentId])
  @@map("knowledge_nodes")
}

// ============================================================================
// Strategy Cohorts
// ============================================================================

model StrategyCohort {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  name           String
  description    String?
  query          String?   // User's analysis query/question
  status         String    @default("draft") // 'draft', 'analyzing', 'completed', 'failed'
  analysisType   String    @default("insights") @map("analysis_type") // 'insights', 'scenarios', 'opportunities', 'deep-dive'

  // Configuration options
  includeFinancial  Boolean @default(false) @map("include_financial")
  includeSocial     Boolean @default(true) @map("include_social")
  includeTech       Boolean @default(false) @map("include_tech")
  includeSentiment  Boolean @default(true) @map("include_sentiment")

  // Results metadata
  executionTimeMs   Int?     @map("execution_time_ms")
  confidence        Float?  @map("confidence") // 0.00-100.00
  insightCount      Int?     @default(0) @map("insight_count")
  swarmId           String?  @map("swarm_id") // Link to Research Swarm execution

  // Timestamps
  lastAnalyzedAt DateTime? @map("last_analyzed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  competitors CohortCompetitor[]
  contexts    CohortContext[]
  insights    CohortInsight[]

  @@index([userId, status])
  @@index([createdAt])
  @@map("strategy_cohorts")
}

model CohortCompetitor {
  id             String   @id @default(uuid())
  cohortId       String   @map("cohort_id")
  name           String
  url            String?
  domain         String?
  industry       String?
  employees      String?  // e.g., "500+", "1000-5000"
  funding        String?  // e.g., "$340M", "Public"
  logoUrl        String?  @map("logo_url")
  status         String   @default("pending") // 'pending', 'analyzing', 'completed', 'failed'

  // AI-enriched data
  discoveredData Json?    @map("discovered_data") // Full AI-discovered company data

  // Timestamps
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  cohort StrategyCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([cohortId])
  @@map("cohort_competitors")
}

model CohortContext {
  id           String   @id @default(uuid())
  cohortId     String   @map("cohort_id")
  contextType  String   @map("context_type") // 'trial-abandoners', 'power-users', 'quick-starters', etc.
  contextLabel String   @map("context_label") // Display label
  percentage   Float?  // e.g., 34.00 for 34%

  // Timestamps
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  cohort StrategyCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([cohortId])
  @@map("cohort_contexts")
}

model CohortInsight {
  id              String   @id @default(uuid())
  cohortId        String   @map("cohort_id")
  title           String
  content         String   
  confidence      String   // 'high', 'medium', 'low'
  category        String   // 'pricing', 'features', 'market', 'retention', 'product', 'integrations'
  sources         String // Array of source URLs and references
  rank            Int      @default(0) // Display order (1-10 for finite introspect)

  // Metadata
  llmProvider     String?  @map("llm_provider") // Which LLM generated this insight
  llmModel        String?  @map("llm_model")    // Which model version

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  cohort StrategyCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([cohortId, rank])
  @@index([category])
  @@map("cohort_insights")
}

// ============================================================================
// Psychographics / Funnel-lytics
// ============================================================================

model PsychographicSegment {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  segmentName     String   @map("segment_name")
  segmentTagline  String?  @map("segment_tagline")
  characteristics Json? // behavioral traits, pain points, motivations
  funnelStage     String?  @map("funnel_stage") // 'awareness', 'consideration', 'decision', 'retention'
  sizeEstimate    Int?     @map("size_estimate")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  insights SegmentInsight[]

  @@map("psychographic_segments")
}

model SegmentInsight {
  id              String   @id @default(uuid())
  segmentId       String   @map("segment_id")
  insightType     String?  @map("insight_type") // 'pain_point', 'motivation', 'objection', 'trigger'
  content         String  
  confidenceScore Float? @map("confidence_score")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  segment PsychographicSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@map("segment_insights")
}

// ============================================================================
// Brewery (Distilled Content)
// ============================================================================

model BreweryOutput {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  outputType   String    @map("output_type") // 'newsletter', 'brief', 'alert'
  title        String   
  content      String   
  sourceItems  String  @map("source_items") // array of intelligence_item IDs
  status       String    @default("brewing") // 'brewing', 'ready', 'delivered'
  scheduledFor DateTime? @map("scheduled_for")
  deliveredAt  DateTime? @map("delivered_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("brewery_outputs")
}

model BreweryItem {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")

  // Content
  title           String
  content         String    
  excerpt         String?    // Short summary for card display

  // Source tracking
  sourceType      String    @map("source_type") // 'research-swarm', 'strategy-cohort', 'intelligence-feed'
  sourceId        String    @map("source_id") // ID of the source item
  sourceName      String?   @map("source_name") // Human-readable source name

  // Metadata
  category        String?   // Category from source (e.g., 'Strategic Insights', 'Market Trends')
  confidence      String?   // Confidence level if applicable ('high', 'medium', 'low')
  tags            String  @default("") // User-added tags for organization

  // Writer request tracking
  writerStatus    String    @default("saved") @map("writer_status") // 'saved', 'request-created', 'assigned', 'in-progress', 'completed'
  writerRequestId String?   @map("writer_request_id") // ID of writer request if created

  // Timestamps
  savedAt         DateTime  @default(now()) @map("saved_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, savedAt])
  @@index([sourceType, sourceId])
  @@index([writerStatus])
  @@map("brewery_items")
}

model WriterRequest {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")

  // Request details
  token           String    @unique // Unique token for writer platform
  breweryItemIds  String  @map("brewery_item_ids") // Array of BreweryItem IDs
  platform        String    // 'linkedin', 'twitter', 'instagram', 'youtube', 'blog', 'facebook'
  contentType     String    @map("content_type") // 'article', 'thread', 'post', 'carousel', 'video-script', 'infographic'
  deadline        DateTime? // Optional deadline for content delivery
  brief           String?    // Additional instructions/requirements

  // Status tracking
  status          String    @default("pending") // 'pending', 'assigned', 'in-progress', 'completed', 'cancelled'
  assignedWriterId String?  @map("assigned_writer_id") // ID from writer platform
  assignedAt      DateTime? @map("assigned_at")
  completedAt     DateTime? @map("completed_at")

  // Deliverables
  deliverables    Json?     // Final content and assets when completed

  // Timestamps
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([token])
  @@map("writer_requests")
}

// ============================================================================
// Obsession Score Tracking
// ============================================================================

model ObsessionScore {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  score        Float   // 0.0 to 10.0
  calculatedAt DateTime @default(now()) @map("calculated_at")
  factors      Json? // breakdown of score components

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, calculatedAt(sort: Desc)])
  @@map("obsession_scores")
}
